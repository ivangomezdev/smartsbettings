{
  "name": "smartbetting-landing",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:vercel": "next build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node --test tests/predictions/*.test.js",
    "verify:predictions": "node --env-file-if-exists=.env.local scripts/verify-predictions-foundation.js",
    "verify:predictions:phase3": "node --env-file-if-exists=.env.local scripts/verify-predictions-phase3.js",
    "verify:predictions:llm": "node --env-file-if-exists=.env.local scripts/verify-openai-structured-output.js",
    "predictions:import:football-data": "node --env-file-if-exists=.env.local scripts/import-football-data.js",
    "predictions:backtest": "node --env-file-if-exists=.env.local scripts/backtest-predictions.js",
    "predictions:dedupe-backtests": "node --env-file-if-exists=.env.local scripts/deduplicate-backtest-runs.js",
    "predictions:benchmark:v1": "node --env-file-if-exists=.env.local scripts/benchmark-poisson-v1.js",
    "predictions:benchmark:v1:report": "node --env-file-if-exists=.env.local scripts/report-benchmark-v1.js",
    "predictions:benchmark:v2": "node --env-file-if-exists=.env.local scripts/benchmark-poisson-v2.js",
    "predictions:research": "node --env-file-if-exists=.env.local scripts/research-predictions.js",
    "predictions:thesportsdb": "node --env-file-if-exists=.env.local scripts/verify-thesportsdb.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^3.0.3",
    "next": "^16.3.0",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.0",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
