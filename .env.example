# Conecta una base de datos PostgreSQL de Neon desde Vercel Marketplace.
DATABASE_URL=postgresql://usuario:contraseña@host/base_de_datos?sslmode=require

# Clave larga y aleatoria para que el panel o las herramientas del administrador carguen picks.
ADMIN_API_KEY=reemplaza-por-una-clave-segura

# Se crea automáticamente al conectar Vercel Blob con el proyecto.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxx

# Reemplázalo por el enlace de referido entregado por Hard Rock Bet.
NEXT_PUBLIC_HARD_ROCK_REFERRAL_URL=https://hardrock.bet/

# API-Football se usa únicamente desde el servidor para Predictions.
API_FOOTBALL_KEY=reemplaza-por-tu-clave-de-api-football

# Márgenes seguros frente a los límites del plan gratuito (100/día y 10/minuto).
API_FOOTBALL_DAILY_BUDGET=90
API_FOOTBALL_MINUTE_BUDGET=9

# TheSportsDB Premium V2 es el proveedor actual principal; API-Football queda como fallback controlado.
THESPORTSDB_API_KEY=reemplaza-por-tu-clave-premium-de-thesportsdb
SPORTS_CURRENT_PROVIDER=thesportsdb
SPORTS_FALLBACK_PROVIDER=api-football
THESPORTSDB_MINUTE_BUDGET=90
THESPORTSDB_DAILY_BUDGET=10000

# Brave Search se usa únicamente desde el servidor para enriquecer Predictions.
WEB_RESEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=reemplaza-por-tu-clave-de-brave-search

# El LLM explica resultados ya calculados; nunca recibe control sobre probabilidades.
PREDICTIONS_LLM_PROVIDER=openai
PREDICTIONS_LLM_MODEL=gpt-5.4-mini
OPENAI_API_KEY=reemplaza-por-tu-clave-de-openai
